# ===== Configuration Backend =====
# L'hôte de votre serveur backend (IP ou domaine + port)
# Exemples:
#   VITE_BACKEND_HOST=localhost:8000          (développement local)
#   VITE_BACKEND_HOST=10.49.161.14:8000       (IP locale)
#   VITE_BACKEND_HOST=api.example.com         (domaine de production)
#   VITE_BACKEND_HOST=api.example.com:8000    (domaine avec port custom)

# VITE_BACKEND_HOST=10.49.161.14:8000
# VITE_BACKEND_API_URL=http://10.49.161.14:8000/api


VITE_BACKEND_HOST=127.0.0.1:8000
VITE_BACKEND_API_URL=http://127.0.0.1:8000/api

# ===== Configuration Frontend =====
# Port de développement (Vite)
VITE_PORT=5173

# Mode environnement
VITE_ENV=development
